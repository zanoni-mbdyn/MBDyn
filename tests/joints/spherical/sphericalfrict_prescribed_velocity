begin: data;
	problem: initial value;
end: data;

begin: initial value;
	initial time: 0.;
	final time: 10.;
	time step: 1.e-4;
	tolerance: 1e-6;
	derivatives coefficient: 1E-7;
	derivatives max iterations: 10;
	derivatives tolerance: 1e3;
	max iterations: 10;
	newton raphson: true;
	linear solver: umfpack;
end: initial value;

begin: control data;
	structural nodes: 2;
	rigid bodies: 1;
	joints: 3;
	forces: 1;
	
	# default output: none;
	print: all;
	#jacobian check: const, 1.;
end: control data;

begin: nodes;
	structural: 1, dynamic,
		null,
		eye,
		null,
		null;
	structural: 2, dynamic,
		null,
		eye,
		null,
		0., 0., 1.;
end: nodes;

scalar function: "constfriction", const, 0.3;

begin: elements;
	joint: 1, clamp, 1, node, node;
	joint: 2, spherical hinge,
		1, reference, node, null,
		hinge, reference, node, eye,
		2, reference, node, null,
		hinge, reference, node, eye
		,
		friction, 0.1,
			preload, 1.,
			modlugre 2D, 2000, 0.1, 0., 0.71, "constfriction",
			#discrete coulomb, "test", const, 1.,
			simple 2D
	;
	joint: 3, angular velocity,
		2, 0., 0., 1., const, 1.;
	body: 2, 2, 1., null, diag, 1.,1.,1.;
	force: 3, absolute, 2, position, null, 1.,0.,0., const, 10.;
end: elements;

