begin: data;
	problem: initial value;
end: data;

begin: initial value;
	initial time: 0.;
	final time: 1.;
	time step: 1e-2;

	tolerance: 1e-6;
	max iterations: 10;
end: initial value;

begin: control data;
	structural nodes: 1;
	joints: 1;
	output elements: 1;
end: control data;

module load: ".libs/libmodule-cosim-output.so";

reference: 99,
	reference, global, 1., 2., 3.,
	reference, global, eye,
	reference, global, null,
	reference, global, null;

begin: nodes;
	structural: 99, dynamic, at reference, 99;
end: nodes;

begin: elements;
	joint: 99, total pin joint,
		99,
			position, reference, node, null,
			position orientation, reference, node, eye,
			rotation orientation, reference, node, eye,
		#
			position, reference, other node, null,
			position orientation, reference, other node, eye,
			rotation orientation, reference, other node, eye,
		position constraint, 1, 1, 1, null,
		orientation constraint, 1, 1, 1, null;

	output element: 98, socket stream,
		# send after, convergence,
                stream name, "COSIM",
                create, yes,
                path, "$MBSKIN", # generated by cosim-output.py and passed via environment
                # port, 10011,
		echo, "output.echo",
		cosimulation, 99;
end: elements;


# vim:ft=mbd

