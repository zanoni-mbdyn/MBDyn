set: integer node_id_rotor 				= 1001;
set: integer node_id_stator				= 1002;

set: integer joint_id_rotor 		        = 3001;
set: integer joint_id_stator 				= 3002;

set: integer elem_id_bearing				= 4001;

set: integer ref_id_bearing                 = 5000;
set: integer ref_id_rotor 					= 5001;
set: integer ref_id_stator 					= 5002;

set:real E1 = 1.18000000000E+11;
set:real nu1 = 3.E-1;
set:real E2 = 1.10000000000E+11;
set:real nu2 = 2.6E-1;

set:real M0 = 1.5965E-13;
set:real M2 = 8.337E-3;
set:real M4 = 7.627100000E+9;

# cylinder_liner_mesh_size [m]
/* mesh size for piston/liner contact*/
set:real cylinder_liner_mesh_size = 1.59632805029062E-3;

# piston_min_nodes_per_division_axial [1]
/* minimum number of nodes which are created between two coordinates of parameter "piston_recess_z" in axial direction*/
set:integer piston_min_nodes_per_division_axial = 1;

# piston_min_nodes_per_division_circumf [1]
/* minimum number of nodes which are created between two coordinates of parameter "piston_recess_phi" in circumferential direction*/
set:integer piston_min_nodes_per_division_circumf = 1;

# piston_recess_phi(1:10, 1:1) [1]
/* circumferential coordinate for local variation of piston diameter*/
set:real piston_recess_phi_1 = 0.E+0;
set:real piston_recess_phi_2 = 17.5 * pi / 180;
set:real piston_recess_phi_3 = 18.5 * pi / 180;
set:real piston_recess_phi_4 = (180 - 18.5) * pi / 180;
set:real piston_recess_phi_5 = (180 - 17.5) * pi / 180;
set:real piston_recess_phi_6 = (180 + 17.5) * pi / 180;
set:real piston_recess_phi_7 = (180 + 18.5) * pi / 180;
set:real piston_recess_phi_8 = (360 - 18.5) * pi / 180;
set:real piston_recess_phi_9 = (360 - 17.5) * pi / 180;
set:real piston_recess_phi_10 = 360 * pi / 180;

# piston_recess_z(1:1, 1:4) [1]
/* axial coordinate for piston recess*/
set:real piston_recess_z_1 = -5.E-1;
set:real piston_recess_z_2 = 7.67319138491747E-2;
set:real piston_recess_z_3 = 1.38092900533841E-1;
set:real piston_recess_z_4 = 5.E-1;

set: real dr = -4e-4;

# piston_recess_d(1:10, 1:4) [m]
/* local variation of piston diameter*/
set:real piston_recess_d_1_1 = 0.E+0;
set:real piston_recess_d_1_2 = 0.E+0;
set:real piston_recess_d_1_3 = 0.E+0;
set:real piston_recess_d_1_4 = 0.E+0;
set:real piston_recess_d_2_1 = 0.E+0;
set:real piston_recess_d_2_2 = 0.E+0;
set:real piston_recess_d_2_3 = 0.E+0;
set:real piston_recess_d_2_4 = 0.E+0;
set:real piston_recess_d_3_1 = dr;
set:real piston_recess_d_3_2 = dr;
set:real piston_recess_d_3_3 = 0.E+0;
set:real piston_recess_d_3_4 = 0.E+0;
set:real piston_recess_d_4_1 = dr;
set:real piston_recess_d_4_2 = dr;
set:real piston_recess_d_4_3 = 0.E+0;
set:real piston_recess_d_4_4 = 0.E+0;
set:real piston_recess_d_5_1 = 0.E+0;
set:real piston_recess_d_5_2 = 0.E+0;
set:real piston_recess_d_5_3 = 0.E+0;
set:real piston_recess_d_5_4 = 0.E+0;
set:real piston_recess_d_6_1 = 0.E+0;
set:real piston_recess_d_6_2 = 0.E+0;
set:real piston_recess_d_6_3 = 0.E+0;
set:real piston_recess_d_6_4 = 0.E+0;
set:real piston_recess_d_7_1 = dr;
set:real piston_recess_d_7_2 = dr;
set:real piston_recess_d_7_3 = 0.E+0;
set:real piston_recess_d_7_4 = 0.E+0;
set:real piston_recess_d_8_1 = dr;
set:real piston_recess_d_8_2 = dr;
set:real piston_recess_d_8_3 = 0.E+0;
set:real piston_recess_d_8_4 = 0.E+0;
set:real piston_recess_d_9_1 = 0.E+0;
set:real piston_recess_d_9_2 = 0.E+0;
set:real piston_recess_d_9_3 = 0.E+0;
set:real piston_recess_d_9_4 = 0.E+0;
set:real piston_recess_d_10_1 = 0.E+0;
set:real piston_recess_d_10_2 = 0.E+0;
set:real piston_recess_d_10_3 = 0.E+0;
set:real piston_recess_d_10_4 = 0.E+0;

set: real omega1z = 0;
set: real omega2z = 0;
set: real v1z = 0;
set: real v2z = 0;
set: real n = 0;
set: real K = 20;
set: real t1 = 1;
set: real dt = t1 / K;

set: real d1 = 25.40215e-3;
set: real D2 = 25.40635e-3;
set: real B = 16.3e-3;
set: real eta = 2.14e-3;
set: real rho = 900.;
set: integer M = 36;
set: integer N = 3;
set: real p_pB2 = 0;
set: real p_mB2 = 0;
set: real epsilon_t0 = 0;
set: real epsilon_t1 = 0;
set: real gamma_t0 = 0;
set: real gamma_t1 = 5;
set: real delta_t0 = pi/2;
set: real delta_t1 = pi/2;

set: real Phi1x_t0 = atan(gamma_t0 * (D2 - d1) / B);
set: real Phi1x_t1 = atan(gamma_t1 * (D2 - d1) / B);
set: real omega1x = (Phi1x_t1 - Phi1x_t0) / t1;

set: real epsilon_dot = (epsilon_t1 - epsilon_t0) / t1;
set: real delta_dot = (delta_t1 - delta_t0) / t1;

begin: data;
	problem: initial value; # the default
end: data;

begin: initial value;
	initial time: 0;
	final time: t1 + 2 * dt;
	time step: dt;

	max iterations: 30;
	tolerance: 1e-6, test, norm, 1e-6, test, norm;
	linear solver: umfpack, colamd, scale, row max column max, always, max iterations, 10;
        include: "noxsolver.set";    
    method: implicit euler;
    output: messages;
    derivatives tolerance: 5e-5;
    derivatives max iterations: 10;
    derivatives coefficient: 1e-3, auto;	
    output: iterations, solver condition number, stat, yes;
    enforce constraint equations: constraint violations, scale factor, 1e6;
end: initial value;

begin: control data;
    skip initial joint assembly;
    make restart file: format, binary;
    print: dof stats, to file;
    print: dof description, to file;
    use: loadable elements, in assembly;
    default orientation: euler123;
	structural nodes: 2;
	joints: 2;
	loadable elements: 1;	
    output precision: 8;
use automatic differentiation;
end: control data;

reference: ref_id_bearing,
	reference, global, null,
	reference, global, eye,
	reference, global, null,
	reference, global, null;

reference: ref_id_rotor,
	reference, ref_id_bearing, 
        (D2 - d1) / 2 * epsilon_t0 * cos(delta_t0), 
        (D2 - d1) / 2 * epsilon_t0 * sin(delta_t0), 
        0.,
	reference, ref_id_bearing, euler123, 
        Phi1x_t0, 
        0., 
        0.,
	reference, ref_id_bearing, 
        (D2 - d1) / 2 * (epsilon_dot * cos(delta_t0) - epsilon_t0 * sin(delta_t0) * delta_dot),
        (D2 - d1) / 2 * (epsilon_dot * sin(delta_t0) + epsilon_t0 * cos(delta_t0) * delta_dot),
        v1z,
	reference, ref_id_bearing, 
        omega1x, 
        0., 
        omega1z;

reference: ref_id_stator,
	reference, ref_id_bearing, null,
	reference, ref_id_bearing, eye,
	reference, ref_id_bearing, 
        0., 
        0., 
        v2z,
	reference, ref_id_bearing, 
        0.,
        0.,
        omega2z;

begin: nodes;
	structural: node_id_rotor, static,
		# position
		reference, ref_id_rotor, null,
		# orientation
		reference, ref_id_rotor, eye,
		# velocity
		reference, ref_id_rotor, null,
		# angular velocity
		reference, ref_id_rotor, null;
				
	structural: node_id_stator, static,
		# position
		reference, ref_id_stator, null,
		# orientation
		reference, ref_id_stator, eye,
		# velocity
		reference, ref_id_stator, null,
		# angular velocity
		reference, ref_id_stator, null;		
end: nodes;

begin: elements;		
	joint: joint_id_rotor, total pin joint,
		node_id_rotor,
			position, reference, ref_id_rotor, null,
			position orientation, reference, ref_id_rotor, eye,
			rotation orientation, reference, ref_id_rotor, eye,
		position, reference, ref_id_bearing, null,
		position orientation, reference, ref_id_bearing, eye,
		rotation orientation, reference, ref_id_bearing, eye,
        position constraint,
            active,
            active,
            active,
        component,
            string, "(D2 - d1) / 2 * (epsilon_t0 + epsilon_dot * Time) * cos(delta_t0 + delta_dot * Time)",
            string, "(D2 - d1) / 2 * (epsilon_t0 + epsilon_dot * Time) * sin(delta_t0 + delta_dot * Time)",
            mult, const, v1z,
                  time,
        orientation constraint,
            active,
            active,
            active,
        component,
            array, 2, 
                const, Phi1x_t0,
                mult, const, omega1x, time,
            const, 0.,
            mult, const, omega1z, 
                  time;

	joint: joint_id_stator, total pin joint,
		node_id_stator,
			position, reference, ref_id_stator, null,
			position orientation, reference, ref_id_stator, eye,
			rotation orientation, reference, ref_id_stator, eye,
		position, reference, ref_id_bearing, null,
		position orientation, reference, ref_id_bearing, eye,
		rotation orientation, reference, ref_id_bearing, eye,
        position constraint,
            active,
            active,
            active,
        component,
            const, 0.,
            const, 0.,
            mult, const, v2z,
                  time,
        orientation constraint,
            active,
            active,
            active,
        component,
            const, 0.,
            const, 0.,
            mult, const, omega2z, 
                  time;

    user defined: elem_id_bearing, 
        hydrodynamic plain bearing2,
            hydraulic fluid, incompressible,
                density, rho,
                viscosity, eta,
                pressure, 0.,
            mesh, linear finite difference, enable mcp, enable_mcp,
            geometry, cylindrical,
                mesh position, at shaft,
                bearing width, B,
                shaft diameter, d1,
                bearing diameter, D2,
			pockets,
				shaft, 1,
				position, 0., 0.,
					complete surface,
					pocket height, surface grid,
					x, 10, 0.5 * d1 * piston_recess_phi_1, 0.5 * d1 * piston_recess_phi_2, 0.5 * d1 * piston_recess_phi_3, 0.5 * d1 * piston_recess_phi_4, 0.5 * d1 * piston_recess_phi_5, 0.5 * d1 * piston_recess_phi_6, 0.5 * d1 * piston_recess_phi_7, 0.5 * d1 * piston_recess_phi_8, 0.5 * d1 * piston_recess_phi_9, 0.5 * d1 * piston_recess_phi_10, 
					z, 4, (B * piston_recess_z_1), (B * piston_recess_z_2), (B * piston_recess_z_3), (B * piston_recess_z_4), 
					delta y,
						piston_recess_d_1_1, piston_recess_d_1_2, piston_recess_d_1_3, piston_recess_d_1_4, 
						piston_recess_d_2_1, piston_recess_d_2_2, piston_recess_d_2_3, piston_recess_d_2_4, 
						piston_recess_d_3_1, piston_recess_d_3_2, piston_recess_d_3_3, piston_recess_d_3_4, 
						piston_recess_d_4_1, piston_recess_d_4_2, piston_recess_d_4_3, piston_recess_d_4_4, 
						piston_recess_d_5_1, piston_recess_d_5_2, piston_recess_d_5_3, piston_recess_d_5_4, 
						piston_recess_d_6_1, piston_recess_d_6_2, piston_recess_d_6_3, piston_recess_d_6_4, 
						piston_recess_d_7_1, piston_recess_d_7_2, piston_recess_d_7_3, piston_recess_d_7_4, 
						piston_recess_d_8_1, piston_recess_d_8_2, piston_recess_d_8_3, piston_recess_d_8_4, 
						piston_recess_d_9_1, piston_recess_d_9_2, piston_recess_d_9_3, piston_recess_d_9_4, 
						piston_recess_d_10_1, piston_recess_d_10_2, piston_recess_d_10_3, piston_recess_d_10_4,
                shaft node,
                    node_id_rotor,
                    offset, reference, ref_id_rotor, null,
                    orientation, reference, ref_id_rotor, eye,
                bearing node,
                    node_id_stator,
                    offset, reference, ref_id_stator, null,
                    orientation, reference, ref_id_stator, eye,
			grid spacing, uniform intervals,
				number of intervals z, 3,
					-0.5 * B, max(((B * piston_recess_z_2) - -0.5 * B) / (B / (B / cylinder_liner_mesh_size)), piston_min_nodes_per_division_axial),
					(B * piston_recess_z_2), max(((B * piston_recess_z_3) - (B * piston_recess_z_2)) / (B / (B / cylinder_liner_mesh_size)), piston_min_nodes_per_division_axial),
					(B * piston_recess_z_3), max(((B * piston_recess_z_4) - (B * piston_recess_z_3)) / (B / (B / cylinder_liner_mesh_size)), piston_min_nodes_per_division_axial),
					(B * piston_recess_z_4), 
				number of intervals x, 9,
					0, max((0.5 * d1 * piston_recess_phi_2 - 0) / (pi * d1 / (pi * d1 / cylinder_liner_mesh_size)), piston_min_nodes_per_division_circumf),
					0.5 * d1 * piston_recess_phi_2, max((0.5 * d1 * piston_recess_phi_3 - 0.5 * d1 * piston_recess_phi_2) / (pi * d1 / (pi * d1 / cylinder_liner_mesh_size)), piston_min_nodes_per_division_circumf),
					0.5 * d1 * piston_recess_phi_3, max((0.5 * d1 * piston_recess_phi_4 - 0.5 * d1 * piston_recess_phi_3) / (pi * d1 / (pi * d1 / cylinder_liner_mesh_size)), piston_min_nodes_per_division_circumf),
					0.5 * d1 * piston_recess_phi_4, max((0.5 * d1 * piston_recess_phi_5 - 0.5 * d1 * piston_recess_phi_4) / (pi * d1 / (pi * d1 / cylinder_liner_mesh_size)), piston_min_nodes_per_division_circumf),
					0.5 * d1 * piston_recess_phi_5, max((0.5 * d1 * piston_recess_phi_6 - 0.5 * d1 * piston_recess_phi_5) / (pi * d1 / (pi * d1 / cylinder_liner_mesh_size)), piston_min_nodes_per_division_circumf),
					0.5 * d1 * piston_recess_phi_6, max((0.5 * d1 * piston_recess_phi_7 - 0.5 * d1 * piston_recess_phi_6) / (pi * d1 / (pi * d1 / cylinder_liner_mesh_size)), piston_min_nodes_per_division_circumf),
					0.5 * d1 * piston_recess_phi_7, max((0.5 * d1 * piston_recess_phi_8 - 0.5 * d1 * piston_recess_phi_7) / (pi * d1 / (pi * d1 / cylinder_liner_mesh_size)), piston_min_nodes_per_division_circumf),
					0.5 * d1 * piston_recess_phi_8, max((0.5 * d1 * piston_recess_phi_9 - 0.5 * d1 * piston_recess_phi_8) / (pi * d1 / (pi * d1 / cylinder_liner_mesh_size)), piston_min_nodes_per_division_circumf),
					0.5 * d1 * piston_recess_phi_9, max((0.5 * d1 * piston_recess_phi_10 - 0.5 * d1 * piston_recess_phi_9) / (pi * d1 / (pi * d1 / cylinder_liner_mesh_size)), piston_min_nodes_per_division_circumf),
            boundary conditions, null, null,
            lubrication grooves, 1,
	       at shaft,
	       pressure, null,
               position, 0., 0.,
               complete surface,
            contact model,
			greenwood tripp,
				E1, E1,
				nu1, nu1,
				E2, E2,
				nu2, nu2,
				base unit, meters,
					M0, M0,
					M2, M2,
					M4, M4,
            output clearance, yes,
            output contact pressure, yes,
            output reaction force, yes,
            output mesh, yes;
end: elements;

##############################################################################################################
## Variables to be updated by simple_testsuite.sh --update-reference-test-status
## Warning, do not edit!!!
## @MBDYN_SIMPLE_TESTSUITE_EXIT_STATUS@ = 0
##############################################################################################################
