set: integer node_id_rotor 				= 1001;
set: integer node_id_stator				= 1002;

set: integer node_id_rotor_T = 2001;
set: integer node_id_stator_T = 2002;

set: integer joint_id_rotor 		        = 3001;
set: integer joint_id_stator 				= 3002;

set: integer elem_id_rotor_T = 4001;
set: integer elem_id_stator_T = 4002;
set: integer elem_id_bearing = 4003;

set: integer ref_id_bearing                 = 5000;
set: integer ref_id_rotor 					= 5001;
set: integer ref_id_stator 					= 5002;

set: integer trace_id_bearing_Pff = 8005;
set: integer trace_id_bearing_Pfc = 8006;
set: integer trace_id_bearing_max_p = 8007;
set: integer trace_id_bearing_max_pc = 8008;
set: integer trace_id_bearing_min_h = 8009;
set: integer trace_id_bearing_min_rho = 8010;
set: integer trace_id_bearing_max_rho = 8011;
set: integer trace_id_bearing_min_T = 8012;
set: integer trace_id_bearing_max_T = 8013;
set: integer trace_id_bearing_mean_T = 8014;

set: bool f_translate = FALSE;
set: bool f_rotate = FALSE;

set: real omega1z = 0;
set: real omega2z = 0;
set: real v1z = 300000. * pi / 30. * 10.5e-3 / 2.;
set: real v2z = 100000. * pi / 30. * 10.5e-3 / 2;
set: real n = 0.5;
set: real K = 360;
set: real t1 = 2 * pi * n / abs(v1z / (10.5e-3 / 2));
set: real dt = t1 / (K * n);
set: real E1 = 2000;
set: real nu1 = 0.3;
set: real E2 = 2000;
set: real nu2 = 0.4;
set: real sigma0 = 1e8;
set: real sigma1 = 0;
set: real mu = 0.2;
set: real sigmaDelta = 2 * 1.4e-5;
set: real M2 = 2 * 0.00189;
set: real M4 = 2 * 0.001939e12;

set: real p0 = 0;
set: real T0 = 273.16;
set: real pside = p0;
set: real Tside = T0;
set: real eta0 = 0.002080141;
set: real Aeta2 = 3.408E+05;
set: real Aeta3 = 4556.6;
set: real rho0 = 900;
set: real gamma = 0;
set: real beta = 2.4e9;
set: real cp0 = 1.71e6 / rho0;
set: real Ac1 = 0.47e-9;
set: real Ac2 = 0.81e-9;
set: real Ac3 = 9.3e-4;
set: real Ac4 = 1.4e-9;
set: real Ac5 = -0.51e-18;
set: real lambda0 = 0.137;
set: real Alambda = 2.96e-4;

set: real d1 = 10.5e-3;
set: real D2 = d1 + 0.1 * sigmaDelta;
set: real B = 8e-3;
set: real M = 10;
set: real N = 6;
set: real epsilon_t0 = 0;
set: real epsilon_t1 = 0;
set: real gamma_t0 = 0;
set: real gamma_t1 = 0;
set: real delta_t0 = 0;
set: real delta_t1 = 0;

set: real Ty0 = 20 + 273.16;
set: real Tyh = 60 + 273.16;

set: real Phi1x_t0 = atan(gamma_t0 * (D2 - d1) / B);
set: real Phi1x_t1 = atan(gamma_t1 * (D2 - d1) / B);
set: real omega1x = (Phi1x_t1 - Phi1x_t0) / t1;

set: real epsilon_dot = (epsilon_t1 - epsilon_t0) / t1;
set: real delta_dot = (delta_t1 - delta_t0) / t1;

begin: data;
	problem: initial value; # the default
end: data;

begin: initial value;
	initial time: 0;
	final time: t1 + 2 * dt;
	time step: dt;
	max iterations: 100;
	tolerance: 1e-5, test, minmax, 1e-4, test, minmax;
	linear solver: umfpack, colamd, scale, row max column max, always, max iterations, 10;
	#nonlinear solver: line search, default solver options, heavy nonlinear, divergence check, no, verbose, no, print convergence info, no;
        include: "noxsolver.set";    
    method: implicit euler;
    output: messages;
    derivatives tolerance: 5e-5, 1e-2;
    derivatives max iterations: 10;
    derivatives coefficient: 3e-3, auto;	
    output: iterations, solver condition number, stat, yes;
end: initial value;

begin: control data;
make restart file: format, binary;
    max iterations: 10;
    initial stiffness: 1e10;
    print: dof stats, to file;
    print: dof description, to file;
    output meter: closest next, t1, forever, const, dt;
    use: loadable elements, in assembly;
    default orientation: euler123;
	structural nodes: 2;
        thermal nodes: 2;
	joints: 2;
        genels: 2;
	loadable elements: 1;
	print: dof stats, to file;
	print: equation description, to file;
	print: dof description, to file;
	print: element connection, to file;
	print: node connection, to file;	
    output precision: 8;
use automatic differentiation;
end: control data;

reference: ref_id_bearing,
	reference, global, 150e-3*f_translate, -250e-3*f_translate, 800e-3*f_translate,
	reference, global, euler123, 30.*pi/180.*f_rotate, 45.*pi/180.*f_rotate, 280.*pi/180.*f_rotate,
	reference, global, null,
	reference, global, null;

# X1 = (D2 - d1) / 2 * (epsilon_t0 + epsilon_dot * Time) * cos(delta_t0 + delta_dot * Time)
# X2 = (D2 - d1) / 2 * (epsilon_t0 + epsilon_dot * Time) * sin(delta_t0 + delta_dot * Time)

# XP1 = (D2 - d1) / 2 * (epsilon_dot * cos(delta_t0) - epsilon_t0 * sin(delta_t0) * delta_dot);
# X2P = (D2 - d1) / 2 * (epsilon_dot * sin(delta_t0) + epsilon_t0 * cos(delta_t0) * delta_dot);

reference: ref_id_rotor,
	reference, ref_id_bearing, 
        (D2 - d1) / 2 * epsilon_t0 * cos(delta_t0), 
        (D2 - d1) / 2 * epsilon_t0 * sin(delta_t0), 
        0.,
	reference, ref_id_bearing, euler123, 
        Phi1x_t0, 
        0., 
        0.,
	reference, ref_id_bearing, 
        (D2 - d1) / 2 * (epsilon_dot * cos(delta_t0) - epsilon_t0 * sin(delta_t0) * delta_dot),
        (D2 - d1) / 2 * (epsilon_dot * sin(delta_t0) + epsilon_t0 * cos(delta_t0) * delta_dot),
        v1z,
	reference, ref_id_bearing, 
        omega1x, 
        0., 
        omega1z;

reference: ref_id_stator,
	reference, ref_id_bearing, null,
	reference, ref_id_bearing, eye,
	reference, ref_id_bearing, 
        0., 
        0., 
        v2z,
	reference, ref_id_bearing, 
        0.,
        0.,
        omega2z;

begin: nodes;
	structural: node_id_rotor, static,
		# position
		reference, ref_id_rotor, 700e-3*f_translate, 800e-3*f_translate, 300e-3*f_translate,
		# orientation
		reference, ref_id_rotor, euler123, 15.*pi/180.*f_rotate, 30.*pi/180.*f_rotate, 80.*pi/180.*f_rotate,
		# velocity
		reference, ref_id_rotor, null,
		# angular velocity
		reference, ref_id_rotor, null;
				
	structural: node_id_stator, static,
		# position
		reference, ref_id_stator, 170e-3*f_translate, -300e-3*f_translate, 240e-3*f_translate,
		# orientation
		reference, ref_id_stator, euler123, -15. * pi / 180.*f_rotate, 45. * pi /180.*f_rotate, 60. * pi / 180.*f_rotate,
		# velocity
		reference, ref_id_stator, null,
		# angular velocity
		reference, ref_id_stator, null;

        thermal: node_id_rotor_T, Tyh;
        thermal: node_id_stator_T, Ty0;
end: nodes;

begin: elements;		
	joint: joint_id_rotor, total pin joint,
		node_id_rotor,
			position, reference, ref_id_rotor, null,
			position orientation, reference, ref_id_rotor, eye,
			rotation orientation, reference, ref_id_rotor, eye,
		position, reference, ref_id_bearing, null,
		position orientation, reference, ref_id_bearing, eye,
		rotation orientation, reference, ref_id_bearing, eye,
        position constraint,
            active,
            active,
            active,
        component,
            string, "(D2 - d1) / 2 * (epsilon_t0 + epsilon_dot * Time) * cos(delta_t0 + delta_dot * Time)",
            string, "(D2 - d1) / 2 * (epsilon_t0 + epsilon_dot * Time) * sin(delta_t0 + delta_dot * Time)",
            mult, const, v1z,
                  time,
        orientation constraint,
            active,
            active,
            active,
        component,
            array, 2, 
                const, Phi1x_t0,
                mult, const, omega1x, time,
            const, 0.,
            mult, const, omega1z, 
                  time;

	joint: joint_id_stator, total pin joint,
		node_id_stator,
			position, reference, ref_id_stator, null,
			position orientation, reference, ref_id_stator, eye,
			rotation orientation, reference, ref_id_stator, eye,
		position, reference, ref_id_bearing, null,
		position orientation, reference, ref_id_bearing, eye,
		rotation orientation, reference, ref_id_bearing, eye,
        position constraint,
            active,
            active,
            active,
        component,
            const, 0.,
            const, 0.,
            mult, const, v2z,
                  time,
        orientation constraint,
            active,
            active,
            active,
        component,
            const, 0.,
            const, 0.,
            mult, const, omega2z, 
                  time;

    genel: elem_id_rotor_T, clamp, node_id_rotor_T, thermal, algebraic, Tyh;

    genel: elem_id_stator_T, clamp, node_id_stator_T, thermal, algebraic, Ty0;

    user defined: elem_id_bearing, 
        hydrodynamic plain bearing2,
            hydraulic fluid, incompressible,
                density, rho0,
                thermal expansion, gamma,
                viscosity, eta0,
                pressure, p0,
                temperature, T0,
                non isothermal,
                Aeta2, Aeta2,
                Aeta3, Aeta3,
                specific heat capacity, cp0,
                Ac1, Ac1,
                Ac2, Ac2,
                Ac3, Ac3,
                Ac4, Ac4,
                Ac5, Ac5,
                thermal conductivity, lambda0,
                Alambda, Alambda,
            mesh, linear finite difference, enable mcp, enable_mcp,
            geometry, cylindrical,
                mesh position, at shaft,
                bearing width, B,
                shaft diameter, d1,
                bearing diameter, D2,
                shaft node,
                    node_id_rotor,
                    offset, reference, ref_id_rotor, null,
                    orientation, reference, ref_id_rotor, eye,
                bearing node,
                    node_id_stator,
                    offset, reference, ref_id_stator, null,
                    orientation, reference, ref_id_stator, eye,
            grid spacing, uniform,
            number of nodes z, M,
            number of nodes Phi, N,
            boundary conditions,
                     pressure, pside,
                     temperature, Tside,
                     pressure, pside,
                     temperature, Tside,
            thermal wall boundary conditions,
                    coupled,                    
                        shaft, node_id_rotor_T,
                        bearing, node_id_stator_T,
            contact model,
                greenwood williamson lugre,
                    E1, E1,
                    nu1, nu1,
                    E2, E2,
                    nu2, nu2,
                    base unit, meters,
                    M0, sigmaDelta^2,
                    M2, M2,
                    M4, M4,
                    method, implicit euler,
                    coulomb friction coefficient, mu,
                    micro slip stiffness, sigma0,
                    micro slip damping, sigma1,
            pressure dof scale, 1.,
            energy balance scale, d1 * pi * B,
            output pressure, yes,
            output contact pressure, yes,
            output temperature, yes,
            output clearance, yes,
            output clearance derivative, no,
            output velocity, yes,
            output stress, yes,
            output contact stress, yes,
            output reaction force, yes,
            output mesh, yes;

    drive caller: trace_id_bearing_Pff, name, "Pff",
        element, elem_id_bearing, loadable, string, "Pff", direct,
        output trace, yes;

    drive caller: trace_id_bearing_Pfc, name, "Pfc",
        element, elem_id_bearing, loadable, string, "Pfc", direct,
        output trace, yes;

    drive caller: trace_id_bearing_max_p, name, "maxp",
        element, elem_id_bearing, loadable, string, "maxp", direct,
        output trace, yes;

    drive caller: trace_id_bearing_max_pc, name, "maxpc",
        element, elem_id_bearing, loadable, string, "maxpc", direct,
        output trace, yes;

    drive caller: trace_id_bearing_min_h, name, "minh",
        element, elem_id_bearing, loadable, string, "minh", direct,
        output trace, yes;

    drive caller: trace_id_bearing_min_rho, name, "minrho",
        element, elem_id_bearing, loadable, string, "minrho", direct,
        output trace, yes;

    drive caller: trace_id_bearing_max_rho, name, "maxrho",
        element, elem_id_bearing, loadable, string, "maxrho", direct,
        output trace, yes;

    drive caller: trace_id_bearing_min_T, name, "minT",
        element, elem_id_bearing, loadable, string, "minT", direct,
        output trace, yes;

    drive caller: trace_id_bearing_max_T, name, "maxT",
        element, elem_id_bearing, loadable, string, "maxT", direct,
        output trace, yes;

    drive caller: trace_id_bearing_mean_T, name, "meanT",
        element, elem_id_bearing, loadable, string, "meanT", direct,
        output trace, yes;
end: elements;

##############################################################################################################
