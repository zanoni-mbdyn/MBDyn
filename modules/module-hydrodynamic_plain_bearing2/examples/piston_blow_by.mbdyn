################################################################
## PARAMETERS
################################################################

set: real piston_diameter = 21.1027e-3;
set: real cylinder_liner_diameter = 21.1067e-3;
set: real piston_pin_d = 4.9925e-3;
set: real piston_recess = -0.2e-3;
set: real crank_radius = 7.9e-3;
set: real conrod_length = 33e-3;
set: real piston_offset = 2e-3;

# thermodynamics
set: real inlet_pressure = 0.627e5;
set: real ambient_pressure = inlet_pressure;
set: real outlet_pressure = 6.04e5;
set: real epsilonK = 0.010943;
set: real kappa = 1.04;

set: real piston_mass = 13.25e-3;
set: real piston_h = 11.8e-3;
set: real piston_q = 6.5e-3;
set: real piston_s = 8.8e-3;
set: real piston_l = 4.4e-3;

set: real conrod_mass = 8.23e-3;
set: real piston_Jxx = piston_mass * (piston_diameter/2.)^2 / 2.;
set: real piston_Jyy = piston_mass * (3 * (piston_diameter/2.)^2 + piston_h^2) / 12.;
set: real piston_Jzz = piston_Jyy;

set: real conrod_center_of_gravity = 9.16e-3;
set: real conrod_momentum_of_inertia = 1.58e-6;

set: real eta = 0.902e-3;		# dynamic oil viscosity
set: real etav = 1e-3 * eta;
set: real rho = 780;
set: real beta = 2.41e9;
set: real pc = 0.1e5;

set: real angular_velocity_crankshaft = -1500*pi/30;	# initial angular velocitiy of the shaft
set: real initial_crank_angle = pi;		# initial angle of rotation of the shaft

set: real initial_conrod_angle = -asin( ( crank_radius * sin(initial_crank_angle) - piston_offset ) / conrod_length );

set: real max_time_step = 1/(360.*2950./60.);
set: real min_time_step = 1e-8;
set: real time_step = max_time_step;

set: real initial_time = 0;
#set: real gas_force_piston_tau = 1e-3/100;
set: real hydrodynamic_tau = 1e-3;
set: real final_time = 3 * 2 * pi / abs(angular_velocity_crankshaft);
set: real output_start_time = 2 * pi / abs(angular_velocity_crankshaft);
set: real output_time_step = time_step / 5;

set: real piston_area = piston_diameter^2 * pi / 4;

set:real cylinder_liner_shape_phi_1 = 0.E+0;
set:real cylinder_liner_shape_phi_2 = 6.28318530717958E+0;

set:real cylinder_liner_shape_z_1 = 2.06E-2;
set:real cylinder_liner_shape_z_2 = 2.11E-2;
set:real cylinder_liner_shape_z_3 = 2.153E-2;
set:real cylinder_liner_shape_z_4 = 4.41E-2;
set:real cylinder_liner_shape_z_5 = 4.64E-2;
set:real cylinder_liner_shape_z_6 = 4.65E-2;
set:real cylinder_liner_shape_z_7 = 4.695E-2;
set:real cylinder_liner_shape_z_8 = 4.71E-2;

set:real cylinder_liner_shape_d_1_1 = 5.E-4;
set:real cylinder_liner_shape_d_1_2 = 5.E-4;
set:real cylinder_liner_shape_d_1_3 = 3.31911764705882E-6;
set:real cylinder_liner_shape_d_1_4 = 0.E+0;
set:real cylinder_liner_shape_d_1_5 = -3.38235294117647E-7;
## set:real cylinder_liner_shape_d_1_6 = 4.34E-5;
## set:real cylinder_liner_shape_d_1_7 = 4.34E-5;
## set:real cylinder_liner_shape_d_1_8 = 3.422E-4
set:real cylinder_liner_shape_d_1_6 = -3.38235294117647E-7;
set:real cylinder_liner_shape_d_1_7 = -3.38235294117647E-7;
set:real cylinder_liner_shape_d_1_8 = -3.38235294117647E-7;

set:real cylinder_liner_shape_d_2_1 = 5.E-4;
set:real cylinder_liner_shape_d_2_2 = 5.E-4;
set:real cylinder_liner_shape_d_2_3 = 3.31911764705882E-6;
set:real cylinder_liner_shape_d_2_4 = 0.E+0;
set:real cylinder_liner_shape_d_2_5 = -3.38235294117647E-7;
## set:real cylinder_liner_shape_d_2_6 = 4.34E-5;
## set:real cylinder_liner_shape_d_2_7 = 4.34E-5;
## set:real cylinder_liner_shape_d_2_8 = 3.422E-4;
set:real cylinder_liner_shape_d_2_6 = -3.38235294117647E-7;
set:real cylinder_liner_shape_d_2_7 = -3.38235294117647E-7;
set:real cylinder_liner_shape_d_2_8 = -3.38235294117647E-7;


################################################################
## ID NUMBERS
################################################################

set: integer node_id_crankcase = 1001;
set: integer node_id_crank_pin = 1002;
set: integer node_id_conrod_big_eye = 1003;
set: integer node_id_piston = 1004;

set: integer hyd_node_id_cylinder_side = 2001;
set: integer hyd_node_id_suction_side = 2002;

set: integer body_id_conrod = 2001;
set: integer body_id_piston = 2002;

set: integer joint_id_crankcase = 3001;
set: integer joint_id_crankshaft_bearing = 3002;
set: integer joint_id_piston_pin = 3003;
set: integer joint_id_crank_pin = 3004;
set: integer joint_id_cylinder_liner = 3005;
set: integer joint_id_cylinder_liner_startup = 3006;

set: integer force_id_gas_force_piston = 4001;

set: integer ref_id_cranktrain = 5001;
set: integer ref_id_crank = 5002;
set: integer ref_id_crank_pin = 5003;
set: integer ref_id_piston = 5004;
set: integer ref_id_conrod_big_eye = 5005;
set: integer ref_id_conrod_center_of_gravity = 5006;

set: integer elem_id_bearing = 6001;

set: integer drive_id_gas_force_piston = 7001;
set: integer drive_id_cylinder_pressure = 7002;
set: integer drive_id_crank_angle = 7003;
set: integer drive_id_gas_force_piston_crank_angle = 7004;
set: integer drive_id_liner_startup = 7005;
set: integer drive_id_time_step = 7006;

set: integer genel_id_mass_flux_cylinder_side = 8001;
set: integer genel_id_mass_flux_suction_side = 8002;

begin: data;
        problem: initial value; # the default
end: data;

begin: initial value;
        initial time: initial_time;
        final time: final_time;

        time step: time_step;
        min time step: min_time_step;
        max time step: max_time_step;
        #max time step: postponed, drive_id_time_step, hard limit, yes;
        enforce constraint equations: constraint violations;
        strategy: factor,
                        # reduction_factor
                                0.5,
                        # steps_before_reduction
                                2,
                        # raise_factor
                                2,
                        # steps_before_raise
                                2,
                        # min_iterations
                                3,
                        # max_iterations
                                6;

        max iterations: 40;
        tolerance: 1.e-5, test, minmax, 1e-4, test, minmax;
        method: bdf;
        derivatives tolerance: 1e-5, 1e-2;
        derivatives max iterations: 10;
        derivatives coefficient: auto;
        output: iterations;
        threads: disable;
        include: "noxsolver.set";            
        output: solver condition number, stat, yes;
end: initial value;

begin: control data;
make restart file: format, binary;
       use: loadable elements, in assembly;
        output meter: closest next, output_start_time, forever, const, output_time_step;
        structural nodes: 4;
        hydraulic nodes: 2;
        rigid bodies: 2;
        loadable elements: 1;
        joints: 5-1;
        forces: 1;
        genels: 2;
        output precision: 8;
        default output: all;
        default output: reference frames;
    max iterations: 100;
    tolerance: 1e-10;
    initial stiffness: 1e12;
    skip initial joint assembly;
use automatic differentiation;
end: control data;

reference: ref_id_cranktrain,
        # position
        reference, global, null,
        # orientation
        reference, global, eye,
        # velocity
        reference, global, null,
        # angular velocity
        reference, global, null;

reference: ref_id_crank,
        # position
        reference, ref_id_cranktrain, null,
        # orientation
        reference, ref_id_cranktrain, matr,
                                                cos(initial_crank_angle), -sin(initial_crank_angle),   0.,
                                                sin(initial_crank_angle),  cos(initial_crank_angle),   0.,
                                                0.,         0.,   1.,

        # velocity
        reference, ref_id_cranktrain, null,
        # angular velocity
        reference, ref_id_cranktrain, 0., 0., angular_velocity_crankshaft;

reference: ref_id_crank_pin,
        # position
        reference, ref_id_crank, crank_radius, 0., 0.,
        # orientation
        reference, ref_id_crank, eye,
        # velocity
        reference, ref_id_crank, null,
        # angular velocity
        reference, ref_id_crank, null;

reference: ref_id_piston,
        #position
        reference, ref_id_cranktrain, (conrod_length*sqrt(cos(2*initial_crank_angle)*crank_radius^2-crank_radius^2+4*piston_offset*sin(initial_crank_angle)*crank_radius+2*conrod_length^2-2*piston_offset^2))/(sqrt(2)*abs(conrod_length))+cos(initial_crank_angle)*crank_radius,
                                                  piston_offset,
                                                  0.,
        # orientation
        reference, ref_id_cranktrain, eye,
        # velocity
        reference, ref_id_cranktrain, (conrod_length*(4*piston_offset*crank_radius*cos(initial_crank_angle)*(angular_velocity_crankshaft)-2*crank_radius^2*(angular_velocity_crankshaft)*sin(2*initial_crank_angle)))/(2*sqrt(2)*abs(conrod_length)*sqrt(crank_radius^2*cos(2*initial_crank_angle)+4*piston_offset*crank_radius*sin(initial_crank_angle)-crank_radius^2+2*conrod_length^2-2*piston_offset^2))-crank_radius*sin(initial_crank_angle)*(angular_velocity_crankshaft),
                                                  0.,
                                                  0.,
        # angular velocity
        reference, ref_id_cranktrain, null;

reference: ref_id_conrod_big_eye,
        # position
        reference, ref_id_crank_pin, null,
        # orientation
        reference, ref_id_cranktrain,  matr,
                                                cos(initial_conrod_angle), -sin(initial_conrod_angle),		0.,
                                                sin(initial_conrod_angle),  cos(initial_conrod_angle),          0.,
                                                0.,                                                0.,          1.,
        # velocity
        reference, ref_id_cranktrain, -crank_radius * angular_velocity_crankshaft * sin(initial_crank_angle), crank_radius * angular_velocity_crankshaft * cos(initial_crank_angle), 0.,
        # angular velocity
        reference, ref_id_cranktrain, 0., 0., -(crank_radius*cos(initial_crank_angle)*(angular_velocity_crankshaft))/(conrod_length*sqrt(1-(crank_radius*sin(initial_crank_angle)-piston_offset)^2/conrod_length^2));

reference: ref_id_conrod_center_of_gravity,
        # position
        reference, ref_id_conrod_big_eye, conrod_center_of_gravity, 0., 0.,
        # orientation
        reference, ref_id_conrod_big_eye, eye,
        # velocity
        reference, ref_id_conrod_big_eye, null,
        # angular velocity
        reference, ref_id_conrod_big_eye, null;

begin: nodes;
    structural: node_id_crankcase, static,
        reference, global, null,
        reference, global, eye,
        reference, global, null,
        reference, global, null;

        structural: node_id_crank_pin, static,
                # absolute position
                reference, ref_id_crank_pin, null,
                # absolute orientation matrix
                reference, ref_id_crank_pin, eye,
                # absolute velocity
                reference, ref_id_crank_pin, null,
                # absolute angular velocity
                reference, ref_id_crank_pin, null;

        structural: node_id_conrod_big_eye, dynamic,
                # absolute position
                reference, ref_id_conrod_big_eye, null,
                # absolute orientation matrix
                reference, ref_id_conrod_big_eye, eye,
                # absolute velocity
                reference, ref_id_conrod_big_eye, null,
                # absolute angular velocity
                reference, ref_id_conrod_big_eye, null;

        structural: node_id_piston, dynamic,
                # absolute position
                reference, ref_id_piston, null,
                # absolute orientation matrix
                reference, ref_id_piston, eye,
                # absolute velocity
                reference, ref_id_piston, null,
                # absolute angular velocity
                reference, ref_id_piston, null;

    hydraulic: hyd_node_id_cylinder_side, value, inlet_pressure;
    hydraulic: hyd_node_id_suction_side, value, inlet_pressure;
end: nodes;

begin: elements;
        drive caller: drive_id_crank_angle,
                string, "initial_crank_angle + angular_velocity_crankshaft * ( Time - initial_time )";

        include: "gas_force_piston_crank_angle2.elm";
        set: [node,Phi_crank_pin,node_id_crank_pin,structural,string="Phi[3]"];

        drive caller: drive_id_gas_force_piston,name,"gas_force_piston",
            drive,
                reference, drive_id_gas_force_piston_crank_angle,
                string, "Phi_crank_pin";

        drive caller: drive_id_cylinder_pressure,
              array, 2,
                    mult, -1. / piston_area,
                          reference, drive_id_gas_force_piston,
                    ambient_pressure;

    force: force_id_gas_force_piston, absolute,
                node_id_piston,
                position,reference,node,null,
                                                        1.,0.,0.,
                reference,drive_id_gas_force_piston;

    joint: joint_id_crankcase, clamp,
        node_id_crankcase, node, node;

        joint: joint_id_crankshaft_bearing, total pin joint,
                        node_id_crank_pin,
                                position,				reference, ref_id_crank, null,
                                position orientation,   reference, ref_id_crank, eye,
                                rotation orientation,   reference, ref_id_crank, eye,
                        position,                        reference, ref_id_cranktrain, null,
                        position orientation, reference, ref_id_cranktrain, eye,
                        rotation orientation, reference, ref_id_cranktrain, eye,
                        position constraint,
                                        active,
                                        active,
                                        active,
                                component, const, 0.,
                                           const, 0.,
                                           const, 0.,
                        orientation constraint,
                                        active,
                                        active,
                                        active,
                                component, const, 0.,
                                           const, 0.,
                                           reference, drive_id_crank_angle;

        joint: joint_id_crank_pin, total joint,
            node_id_crank_pin,
                position, reference, ref_id_crank_pin, null,
                position orientation, reference, ref_id_crank_pin, eye,
                                rotation orientation,   reference, ref_id_crank_pin, eye,
            node_id_conrod_big_eye,
                position, reference, ref_id_conrod_big_eye, null,
                position orientation, reference, ref_id_conrod_big_eye, eye,
                rotation orientation, reference, ref_id_conrod_big_eye, eye,
                        position constraint,
                                        active,
                                        active,
                                        active,
                                component, const, 0.,
                                                   const, 0.,
                                                   const, 0.,
                        orientation constraint,
                                        active,
                                        active,
                                        inactive,
                                component, const, 0.,
                                                   const, 0.,
                                                   const, 0.;

        joint: joint_id_piston_pin, revolute hinge,
                # node 1
                node_id_piston,
                        # relative offset
                        reference, ref_id_piston, null,
                        hinge,
                                1,1.,0.,0.,3,0.,0.,1.,
                # node 2
                node_id_conrod_big_eye,
                        # relative offset
                        reference, ref_id_piston, null,
                        hinge,
                                1,1.,0.,0.,3,0.,0.,1.;

        body: body_id_conrod, node_id_conrod_big_eye,
                # mass
                conrod_mass,
                # relative center of mass
                reference, ref_id_conrod_center_of_gravity, null,
                # inertia matrix
                diag, 0.,  0., conrod_momentum_of_inertia,
                inertial, reference, ref_id_conrod_center_of_gravity, eye;

        body: body_id_piston, node_id_piston,
                # mass
                piston_mass,
                # relative center of mass
                reference, ref_id_piston, null,
                # inertia matrix
                diag, 0., 0., piston_Jzz,
                inertial, reference, ref_id_piston, eye;

    genel: genel_id_mass_flux_cylinder_side, clamp,
        hyd_node_id_cylinder_side, hydraulic, reference, drive_id_cylinder_pressure;

    genel: genel_id_mass_flux_suction_side, clamp,
        hyd_node_id_suction_side, hydraulic, const, inlet_pressure;

    user defined: elem_id_bearing,
        hydrodynamic plain bearing2,
           hydraulic fluid, incompressible,
                        density, rho,
                        viscosity, eta,
                        pressure, pc,
            mesh, linear finite difference, enable mcp, enable_mcp,
            geometry, cylindrical,
                mesh position, at shaft,
                bearing width, piston_h,
                shaft diameter, piston_diameter,
                bearing diameter, cylinder_liner_diameter,
                pockets,
                    shaft, 4,
                        position, 0., piston_h / 2 - piston_q,
                            circle,
                                radius, piston_pin_d / 2,
                            pocket height,
                                const, -0.5e-3,
                        position, piston_diameter * pi / 2, piston_h / 2 - piston_q,
                            circle,
                                radius, piston_pin_d / 2,
                            pocket height,
                                const, -0.5e-3,
                        position, 0., -piston_h / 2,
                            rectangle,
                                width, piston_diameter * pi / 2 - piston_s,
                                height, 2 * (piston_h - piston_l),
                            pocket height,
                                const, piston_recess,
                        position, piston_diameter * pi /2, -piston_h / 2,
                            rectangle,
                                width, piston_diameter * pi / 2 - piston_s,
                                height, 2 * (piston_h - piston_l),
                            pocket height,
                                const, piston_recess,
                    bearing, 1,
                                position, 0., 0.,
                                        complete surface,
                                        pocket height, surface grid,
                                        x, 2, 0.5 * piston_diameter * cylinder_liner_shape_phi_1, 0.5 * piston_diameter * cylinder_liner_shape_phi_2,
                                        z, 8, cylinder_liner_shape_z_1, cylinder_liner_shape_z_2, cylinder_liner_shape_z_3, cylinder_liner_shape_z_4, cylinder_liner_shape_z_5, cylinder_liner_shape_z_6, cylinder_liner_shape_z_7, cylinder_liner_shape_z_8,
                                        delta y,
                                                0.5 * (cylinder_liner_shape_d_1_1), 0.5 * (cylinder_liner_shape_d_1_2), 0.5 * (cylinder_liner_shape_d_1_3), 0.5 * (cylinder_liner_shape_d_1_4), 0.5 * (cylinder_liner_shape_d_1_5), 0.5 * (cylinder_liner_shape_d_1_6), 0.5 * (cylinder_liner_shape_d_1_7), 0.5 * (cylinder_liner_shape_d_1_8),
                                                0.5 * (cylinder_liner_shape_d_2_1), 0.5 * (cylinder_liner_shape_d_2_2), 0.5 * (cylinder_liner_shape_d_2_3), 0.5 * (cylinder_liner_shape_d_2_4), 0.5 * (cylinder_liner_shape_d_2_5), 0.5 * (cylinder_liner_shape_d_2_6), 0.5 * (cylinder_liner_shape_d_2_7), 0.5 * (cylinder_liner_shape_d_2_8),
                shaft node,
                    node_id_piston,
                    offset, reference, ref_id_piston, piston_q - 0.5 * piston_h, 0., 0.,
                    orientation, reference, ref_id_piston, 3, 1., 0., 0.,
                                                           1, 0., 0., 1.,
                bearing node,
                    node_id_crankcase,
                    offset, reference, ref_id_cranktrain, 0., piston_offset, 0.,
                    orientation, reference, ref_id_cranktrain, 3, 1., 0., 0.,
                                                           1, 0., 0., 1.,
           grid spacing, uniform intervals,
            number of intervals z, 2,
                -0.5 * piston_h, 10,
                 0.5 * piston_h - piston_l, 30,
                 0.5 * piston_h,
            number of intervals x, 1,
                 0., 75,
            pressure coupling conditions axial,
                hyd_node_id_suction_side,
                hyd_node_id_cylinder_side,
            contact model,
                #greenwood williamson,
                greenwood williamson lugre,
                    E1, 210000e6,
                    nu1, 0.3,
                    E2, 210000e6,
                    nu2, 0.3,
                    M0, 0.15965,
                    M2, 0.008337,
                    M4, 0.0076271,
                    method, implicit euler,
                    coulomb friction coefficient, 0.1,
                    micro slip stiffness, 1e5,
                    micro slip damping, 1e2,
            pressure dof scale, 1e8,
            reynolds equation scale, 1e-1 * time_step / (rho * 0.5 * (cylinder_liner_diameter - piston_diameter)),
            output pressure, yes,
            output density, yes,
            output contact pressure, yes,
            output clearance, yes,
            output clearance derivative, yes,
            output velocity, yes,
            output stress, yes,
            output contact stress, yes,
            output reaction force, yes,
            output friction loss, yes,
            output mass flux, yes,
            output volume flux, yes,
            output mesh, yes;

    drive caller: drive_id_time_step,
        max, 2,
            const, min_time_step,
            min, 2,
                const, max_time_step,
                element, elem_id_bearing, loadable, string, "maxdt", direct;
end: elements;

##############################################################################################################
## Variables to be updated by simple_testsuite.sh --update-reference-test-status
## Warning, do not edit!!!
## @MBDYN_SIMPLE_TESTSUITE_EXIT_STATUS@ = 0
##############################################################################################################
