set: real Di = 200e-3;
set: real Do = 299e-3;
set: real Wo = 200e-3;
set: real rho = 7850;
set: real T1 = 100;
set: real T2 = 20;
set: real m1 = (Do^2 - Di^2) * pi / 4. * Wo * rho;
set: real c1 = 470;
set: real A12 = Do * pi * Wo + 2 * (Do^2 - Di^2) * pi / 4;
set: real alpha12 = 50;
set: real P1 = 100;

set: integer node_id_T1 = 4001;
set: integer node_id_T2 = 4002;
set: integer elem_id_T2 = 5001;
set: integer elem_id_m1 = 5002;
set: integer elem_id_k12 = 5003;
set: integer elem_id_P1 = 5004;

begin: data;
	problem: initial value; # the default
end: data;

begin: initial value;
	initial time: 0;
	final time: 36000;
	time step: 10;
	max iterations: 100;
	tolerance: 1e-5, test, minmax, 1e-4, test, minmax;
	linear solver: umfpack, colamd, scale, row max column max, always, max iterations, 10;
	#nonlinear solver: line search, default solver options, heavy nonlinear, divergence check, no, verbose, no, print convergence info, no;
        include: "noxsolver.set";            
        derivatives tolerance: 1e-6, 1e-2;
        derivatives max iterations: 10;
        derivatives coefficient: auto;
    method: ms, 0.6;
    output: iterations, solver condition number, stat, yes;
end: initial value;

begin: control data;
#make restart file: format, binary;
       max iterations: 10;
       thermal nodes: 2;
       genels: 3;
       forces: 1;
use automatic differentiation;
end: control data;

begin: nodes;
        thermal: node_id_T1, T1;
        thermal: node_id_T2, T2;        
end: nodes;

begin: elements;		
    genel: elem_id_T2, clamp, node_id_T2, thermal, algebraic, T2;
    genel: elem_id_m1, spring support, node_id_T1, thermal, algebraic, linear viscous generic, m1 * c1;
    genel: elem_id_k12, spring, node_id_T1, thermal, algebraic, node_id_T2, thermal, algebraic, linear elastic generic, A12 * alpha12;
    force: elem_id_P1, abstract, node_id_T1, thermal, P1;
end: elements;

