set: integer node_id_rotor 				= 1001;
set: integer node_id_stator				= 1002;

set: integer joint_id_rotor 		        = 3001;
set: integer joint_id_stator 				= 3002;

set: integer elem_id_bearing				= 4001;

set: integer ref_id_bearing                 = 5000;
set: integer ref_id_rotor 					= 5001;
set: integer ref_id_stator 					= 5002;

set:real E1 = 1.18000000000E+11;
set:real nu1 = 3.E-1;
set:real E2 = 1.10000000000E+11;
set:real nu2 = 2.6E-1;

set:real M0 = 1.5965E-13;
set:real M2 = 8.337E-3;
set:real M4 = 7.627100000E+9;


set: real Phi1 = 16.1 * pi / 180;
set: real Phi2 = 17.6 * pi / 180;
set: real Phi3 = 47.6 * pi / 180;

set: real omega1z = 0;
set: real omega2z = 0;
set: real v1z = 0;
set: real v2z = 0;
set: real n = 0;
set: real K = 20;
set: real t1 = 1;
set: real dt = t1 / K;

set: real d1 = 25.40215e-3;
set: real D2 = 25.40635e-3;
set: real dr = -0.2e-3;
set: real B = 16.3e-3;
set: real eta = 2.14e-3;
set: real rho = 900.;
set: integer M = 36;
set: integer N = 3;
set: real p_pB2 = 0;
set: real p_mB2 = 0;
set: real epsilon_t0 = 0;
set: real epsilon_t1 = 0;
set: real gamma_t0 = 0;
set: real gamma_t1 = 5;
set: real delta_t0 = pi/2;
set: real delta_t1 = pi/2;

set: real Phi1x_t0 = atan(gamma_t0 * (D2 - d1) / B);
set: real Phi1x_t1 = atan(gamma_t1 * (D2 - d1) / B);
set: real omega1x = (Phi1x_t1 - Phi1x_t0) / t1;

set: real epsilon_dot = (epsilon_t1 - epsilon_t0) / t1;
set: real delta_dot = (delta_t1 - delta_t0) / t1;

begin: data;
	problem: initial value; # the default
end: data;

begin: initial value;
	initial time: 0;
	final time: t1 + 2 * dt;
	time step: dt;

	strategy: factor, 0.5, 3, 2, 3, 15, 20;
	max iterations: 30;
	tolerance: 1e-6, test, norm, 1e-6, test, norm;
	linear solver: umfpack, colamd, scale, row max column max, always, max iterations, 10;
        include: "noxsolver.set";            

    method: implicit euler;
    output: messages;
    derivatives tolerance: 5e-5;
    derivatives max iterations: 10;
    derivatives coefficient: 1e-3, auto;	
    output: iterations, solver condition number, stat, yes;
    enforce constraint equations: constraint violations, scale factor, 1e6;
end: initial value;

begin: control data;
    skip initial joint assembly;
    make restart file: format, binary;
    print: dof stats, to file;
    print: dof description, to file;
    use: loadable elements, in assembly;
    default orientation: euler123;
	structural nodes: 2;
	joints: 2;
	loadable elements: 1;	
    output precision: 8;
use automatic differentiation;
end: control data;

reference: ref_id_bearing,
	reference, global, null,
	reference, global, eye,
	reference, global, null,
	reference, global, null;

reference: ref_id_rotor,
	reference, ref_id_bearing, 
        (D2 - d1) / 2 * epsilon_t0 * cos(delta_t0), 
        (D2 - d1) / 2 * epsilon_t0 * sin(delta_t0), 
        0.,
	reference, ref_id_bearing, euler123, 
        Phi1x_t0, 
        0., 
        0.,
	reference, ref_id_bearing, 
        (D2 - d1) / 2 * (epsilon_dot * cos(delta_t0) - epsilon_t0 * sin(delta_t0) * delta_dot),
        (D2 - d1) / 2 * (epsilon_dot * sin(delta_t0) + epsilon_t0 * cos(delta_t0) * delta_dot),
        v1z,
	reference, ref_id_bearing, 
        omega1x, 
        0., 
        omega1z;

reference: ref_id_stator,
	reference, ref_id_bearing, null,
	reference, ref_id_bearing, eye,
	reference, ref_id_bearing, 
        0., 
        0., 
        v2z,
	reference, ref_id_bearing, 
        0.,
        0.,
        omega2z;

begin: nodes;
	structural: node_id_rotor, static,
		# position
		reference, ref_id_rotor, null,
		# orientation
		reference, ref_id_rotor, eye,
		# velocity
		reference, ref_id_rotor, null,
		# angular velocity
		reference, ref_id_rotor, null;
				
	structural: node_id_stator, static,
		# position
		reference, ref_id_stator, null,
		# orientation
		reference, ref_id_stator, eye,
		# velocity
		reference, ref_id_stator, null,
		# angular velocity
		reference, ref_id_stator, null;		
end: nodes;

begin: elements;		
	joint: joint_id_rotor, total pin joint,
		node_id_rotor,
			position, reference, ref_id_rotor, null,
			position orientation, reference, ref_id_rotor, eye,
			rotation orientation, reference, ref_id_rotor, eye,
		position, reference, ref_id_bearing, null,
		position orientation, reference, ref_id_bearing, eye,
		rotation orientation, reference, ref_id_bearing, eye,
        position constraint,
            active,
            active,
            active,
        component,
            string, "(D2 - d1) / 2 * (epsilon_t0 + epsilon_dot * Time) * cos(delta_t0 + delta_dot * Time)",
            string, "(D2 - d1) / 2 * (epsilon_t0 + epsilon_dot * Time) * sin(delta_t0 + delta_dot * Time)",
            mult, const, v1z,
                  time,
        orientation constraint,
            active,
            active,
            active,
        component,
            array, 2, 
                const, Phi1x_t0,
                mult, const, omega1x, time,
            const, 0.,
            mult, const, omega1z, 
                  time;

	joint: joint_id_stator, total pin joint,
		node_id_stator,
			position, reference, ref_id_stator, null,
			position orientation, reference, ref_id_stator, eye,
			rotation orientation, reference, ref_id_stator, eye,
		position, reference, ref_id_bearing, null,
		position orientation, reference, ref_id_bearing, eye,
		rotation orientation, reference, ref_id_bearing, eye,
        position constraint,
            active,
            active,
            active,
        component,
            const, 0.,
            const, 0.,
            mult, const, v2z,
                  time,
        orientation constraint,
            active,
            active,
            active,
        component,
            const, 0.,
            const, 0.,
            mult, const, omega2z, 
                  time;

    user defined: elem_id_bearing, 
        hydrodynamic plain bearing2,
            hydraulic fluid, incompressible,
                density, rho,
                viscosity, eta,
                pressure, 0.,
            mesh, linear finite difference, enable mcp, enable_mcp,
            geometry, cylindrical,
                mesh position, at shaft,
                bearing width, B,
                shaft diameter, d1,
                bearing diameter, D2,
                pockets,
	            shaft, 1,
		      position, 0., 0.,
		      complete surface,
		      pocket height,
                            surface grid,
			        x, 6,
                                   0.,
                                   0.5 * d1 * Phi2,
                                   0.5 * d1 * Phi3,
                                   0.5 * d1 * (pi - Phi3),
                                   0.5 * d1 * (pi - Phi2),
                                   0.5 * d1 * pi, 
				z, 2,
                                   -0.5 * B,
                                    0.5 * B,
				delta y,
	                           0.,  0.,
                                   0.,  0.,
                                   dr,  dr,
                                   dr,  dr,
                                    0,   0,
                                    0,   0,
                shaft node,
                    node_id_rotor,
                    offset, reference, ref_id_rotor, null,
                    orientation, reference, ref_id_rotor, eye,
                bearing node,
                    node_id_stator,
                    offset, reference, ref_id_stator, null,
                    orientation, reference, ref_id_stator, eye,
            	    grid spacing, uniform intervals,
				number of intervals z, 1,
					-0.5 * B, N,
                                         0.5 * B,
				number of intervals x, 8,
					0.,                      5,
                                        0.5 * d1 * Phi1,        10,
					0.5 * d1 * Phi2,        10,
                                        0.5 * d1 * Phi3,         2,
                                        0.5 * d1 * (pi - Phi3), 10,
                                        0.5 * d1 * (pi - Phi2), 10,
                                        0.5 * d1 * (pi - Phi1),  5,
                                        0.5 * d1 * pi,           2,
            boundary conditions, null, null,
            lubrication grooves, 1,
	       at shaft,
	       pressure, null,
               position, 0., 0.,
               complete surface,
            contact model,
			greenwood tripp,
				E1, E1,
				nu1, nu1,
				E2, E2,
				nu2, nu2,
				base unit, meters,
					M0, M0,
					M2, M2,
					M4, M4,
            output clearance, yes,
            output contact pressure, yes,
            output reaction force, yes,
            output mesh, yes;
end: elements;

##############################################################################################################
## Variables to be updated by simple_testsuite.sh --update-reference-test-status
## Warning, do not edit!!!
## @MBDYN_SIMPLE_TESTSUITE_EXIT_STATUS@ = 0
